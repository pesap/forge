set dotenv-load := false

default:
    @just --list

{{ docs_recipe }}
format:
    cargo fmt --all
{{ component_format_steps }}hooks-install:
    uv run prek install

lint:
    cargo clippy --workspace --all-targets --all-features -- -D warnings

sync:
    uv sync --all-groups

test:
    cargo test

verify:
    uv lock --check
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --all-features -- -D warnings
    uv run --locked prek run --all-files
    cargo test
