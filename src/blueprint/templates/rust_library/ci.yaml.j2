name: CI

on:
  push:
    branches: [main]
  pull_request:

{{ cancel_redundant_ci_concurrency }}{{ read_only_permissions }}jobs:
  verify:
    runs-on: ubuntu-latest
{{ job_timeout }}    steps:
{{ read_only_checkout_step }}      - name: Install Rust
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
{{ setup_uv_step }}{{ install_forge_step }}{{ uv_sync_locked_step }}{{ uv_lock_check_step }}      - run: cargo fmt --all --check
      - run: cargo clippy --workspace --all-targets --all-features -- -D warnings
{{ prek_step }}{{ forge_sync_check_step }}      - run: cargo test
