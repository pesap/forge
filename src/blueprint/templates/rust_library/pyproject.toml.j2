[project]
name = {{ project_name }}
version = "0.1.0"
description = {{ description }}
requires-python = ">=3.11"
dependencies = []

[dependency-groups]
dev = [
    "prek>=0.3.5,<0.4.0",
]
{{ docs_group }}
[tool.forge]
blueprint = "{{ blueprint_name }}>={{ blueprint_version }}"
project_name = {{ project_name }}
crate_name = {{ crate_name }}
description = {{ description }}
{{ author_name }}{{ author_email }}license = {{ license }}
rust_edition = {{ rust_edition }}
{{ forge_overrides }}
