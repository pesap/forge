{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "section": "Features",
          "type": "feat"
        },
        {
          "section": "Bug Fixes",
          "type": "fix"
        },
        {
          "section": "Performance",
          "type": "perf"
        },
        {
          "section": "Refactors",
          "type": "refactor"
        },
        {
          "section": "Documentation",
          "type": "docs"
        },
        {
          "section": "Miscellaneous",
          "type": "chore"
        }
      ],
      "extra-files": [
        "src/*/__init__.py"
      ]
    }
  },
  "release-type": "python"
}
