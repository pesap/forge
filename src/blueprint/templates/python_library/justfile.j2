set dotenv-load := false

default:
    @just --list

sync:
    uv sync --all-groups

hooks-install:
    uv run prek install

setup: hooks-install sync
{{ docs_recipe }}
format:
    uv run ruff format .
{{ component_format_steps }}lint:
    uv run ruff check --fix .
    uv run ty check

test:
    uv run pytest -q

smoke:
    uv run python -c "import {{ package_name_unquoted }}"

build:
    uv build

verify:
    uv lock --check
    uv run --locked ruff format --check .
    uv run --locked ruff check .
    uv run --locked ty check
    uv run --locked prek run --all-files
    forge update --path . --check
    uv run --locked pytest --tb=short
    uv build --locked
