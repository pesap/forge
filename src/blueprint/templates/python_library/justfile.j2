set dotenv-load := false

default:
    @just --list

build:
    uv build
{{ docs_recipe }}
format:
    uv run ruff format .
{{ component_format_steps }}hooks-install:
    uv run prek install

lint:
    uv run ruff check --fix .
    uv run ty check

setup: hooks-install sync

smoke:
    uv run python -c "import {{ package_name_unquoted }}"

sync:
    uv sync --all-groups

test:
    uv run pytest -q

verify:
    uv lock --check
    uv run --locked ruff format --check .
    uv run --locked ruff check .
    uv run --locked ty check
    uv run --locked prek run --all-files
    uv run --locked pytest --tb=short
    uv build --locked
