name: release-please

on:
  push:
    branches: [main]

{{ serialized_ref_concurrency }}permissions:
  contents: write
  pull-requests: write
  issues: write

jobs:
  release-please:
    runs-on: ubuntu-latest
{{ job_timeout }}    steps:
      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
      # publish is handled by .github/workflows/publish.yaml after release creation
