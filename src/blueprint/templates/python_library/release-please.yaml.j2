name: release-please

on:
  push:
    branches: [main]

{{ serialized_ref_concurrency }}permissions:
  contents: write
  pull-requests: write
  issues: write
  id-token: write

jobs:
  release-please:
    runs-on: ubuntu-latest
{{ job_timeout }}    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
{{ pypi_publish_block }}
