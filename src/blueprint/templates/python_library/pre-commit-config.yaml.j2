{% include "shared/_pre_commit_header.yaml.j2" %}
{% if python_rules %}      - id: ruff-format
        name: ruff format check
        entry: uv run --locked ruff format --check
        language: system
        types_or: [python, pyi]
      - id: ruff-check
        name: ruff check
        entry: uv run --locked ruff check
        language: system
        types_or: [python, pyi]
      - id: ty-check
        name: ty check
        entry: uv run --locked ty check
        language: system
        types_or: [python, pyi]
{% endif %}{{ component_hooks }}{% if python_rules %}      - id: pytest
        name: pytest
        entry: uv run --locked pytest -q --maxfail=1
        language: system
        pass_filenames: false
        stages: [pre-push]
{% endif %}{{ uv_lock_hook }}
