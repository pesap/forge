{% include "shared/_pre_commit_header.yaml.j2" %}
{% if python_rules %}      - id: ruff-format
        name: ruff format check
        entry: uv run --locked ruff format --check
        language: system
        types_or: [python, pyi]
      - id: ruff-check
        name: ruff check
        entry: uv run --locked ruff check
        language: system
        types_or: [python, pyi]
      - id: ty-check
        name: ty check
        entry: uv run --locked ty check
        language: system
        types_or: [python, pyi]
{% endif %}      - id: pretty-format-json
{{ component_hooks }}{% if python_rules %}      - id: pytest
        name: pytest
        entry: uv run --locked pytest -q --maxfail=1 -m "not slow"
        language: system
        pass_filenames: false
        stages: [pre-push]
{% endif %}
  - repo: https://github.com/commitizen-tools/commitizen
    rev: v4.9.1
    hooks:
      - id: commitizen
      - id: commitizen-branch
  - repo: local
    hooks:
      - id: cspell
        name: cspell
        entry: uvx cspell --no-progress --no-must-find-files
        language: system
        files: \.(md|txt|py|toml|ya?ml|json)$
{{ uv_lock_hook }}
