default_install_hook_types:
  - pre-commit
  - pre-push
repos:
  - repo: local
    hooks:
      - id: ruff-format
        name: ruff format check
        entry: uv run --locked ruff format --check
        language: system
        types_or: [python, pyi]
      - id: ruff-check
        name: ruff check
        entry: uv run --locked ruff check
        language: system
        types_or: [python, pyi]
      - id: ty-check
        name: ty check
        entry: uv run --locked ty check
        language: system
        types_or: [python, pyi]
{{ component_hooks }}      - id: pytest
        name: pytest
        entry: uv run --locked pytest -q --maxfail=1
        language: system
        pass_filenames: false
        stages: [pre-push]
{{ forge_update_check_hook }}{{ uv_lock_hook }}
