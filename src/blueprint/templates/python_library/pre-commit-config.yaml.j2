{% include "shared/_pre_commit_header.yaml.j2" %}
{% if python_rules %}      - id: ruff-format
        name: ruff format check
        entry: uv run --locked ruff format --check
        language: system
        types_or: [python, pyi]
      - id: ruff-check
        name: ruff check
        entry: uv run --locked ruff check
        language: system
        types_or: [python, pyi]
      - id: ty-check
        name: ty check
        entry: uv run --locked ty check
        language: system
        types_or: [python, pyi]
{% endif %}{{ component_hooks }}{% if python_rules %}      - id: pytest
        name: pytest
        entry: uv run --locked pytest -q --maxfail=1 -m "not slow"
        language: system
        pass_filenames: false
        stages: [pre-push]
{% endif %}      # Commitizen's upstream pre-push hook exits non-zero on empty ranges, so Forge keeps a small wrapper that falls back when push refs are missing or unborn.
      - id: commitizen-branch
        name: commitizen check branch
        entry: >-
          bash -c 'range="origin/main..HEAD";
          if [ -n "$PRE_COMMIT_FROM_REF" ] && [ -n "$PRE_COMMIT_TO_REF" ]; then
            if git rev-parse --verify "$PRE_COMMIT_FROM_REF" >/dev/null 2>&1 &&
               git rev-parse --verify "$PRE_COMMIT_TO_REF" >/dev/null 2>&1; then
              range="$PRE_COMMIT_FROM_REF..$PRE_COMMIT_TO_REF";
            fi;
          fi;
          count="$(git rev-list --count "$range" 2>/dev/null || echo 0)";
          if [ "$count" = "0" ]; then echo "No commits to check in $range"; exit 0; fi;
          uvx --from commitizen=={{ commitizen_version }} cz check --rev-range "$range"'
        language: system
        pass_filenames: false
        stages: [pre-push]

  - repo: https://github.com/commitizen-tools/commitizen
    rev: v{{ commitizen_version }}
    hooks:
      - id: commitizen
        stages: [commit-msg]
  - repo: https://github.com/crate-ci/typos
    rev: v1.47.2
    hooks:
      - id: typos
        args: ["--force-exclude"]
{{ uv_lock_hook }}
