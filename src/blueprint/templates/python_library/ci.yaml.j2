name: CI

on:
  push:
    branches: [main]
  pull_request:

{{ cancel_redundant_ci_concurrency }}{{ read_only_permissions }}jobs:
  pytest:
    runs-on: ubuntu-latest
{{ job_timeout }}    strategy:
      matrix:
        python-version: {% raw %}${{ github.event_name == 'pull_request' && fromJSON('["3.14"]') || fromJSON('[{% endraw %}{{ python_matrix }}{% raw %}]') }}{% endraw %}
    steps:
{{ read_only_checkout_step }}{{ setup_uv_step }}      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6.2.0
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
{{ uv_sync_locked_step }}      - run: uv run --locked pytest --cov --cov-report=xml
{{ codecov_step }}
  prek:
    runs-on: ubuntu-latest
{{ job_timeout }}    steps:
{{ read_only_checkout_step }}{{ setup_uv_step }}      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6.2.0
        with:
          python-version: "3.14"
{{ uv_sync_locked_step }}      - run: uv run --locked prek run --all-files

  smoke:
    runs-on: ubuntu-latest
{{ job_timeout }}    steps:
{{ read_only_checkout_step }}{{ setup_uv_step }}      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6.2.0
        with:
          python-version: "3.14"
{{ uv_sync_locked_step }}      - run: uv run --locked python -c "import {{ package_name }}"

  windows-smoke:
    runs-on: windows-latest
{{ job_timeout }}    steps:
{{ read_only_checkout_step }}{{ setup_uv_step }}      - uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6.2.0
        with:
          python-version: "3.14"
{{ uv_sync_locked_step }}      - run: uv run --locked pytest
