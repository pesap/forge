name: forge-sync

on:
  schedule:
    - cron: "0 8 * * 1"
  workflow_dispatch:

{{ serialized_sync_concurrency }}permissions:
  contents: write
  pull-requests: write

jobs:
  sync:
    runs-on: ubuntu-latest
{{ job_timeout }}    steps:
{{ read_only_checkout_step }}      - name: Install Rust
        uses: dtolnay/rust-toolchain@29eef336d9b2848a0b548edc03f92a220660cdb8 # stable
{{ setup_uv_step }}{{ install_forge_step }}      - name: Sync Forge-managed infrastructure
        run: forge sync --path . --yes
      - name: Detect lockfile-relevant metadata changes
        id: forge_changes
        run: |
          python3 <<'PY'
          import os
          import subprocess
          import tomllib
          from pathlib import Path

          def load_lockfile_relevant_pyproject(content):
              data = tomllib.loads(content)
              project = data.get("project", {})
              if not isinstance(project, dict):
                  project = {}
              tool = data.get("tool", {})
              if not isinstance(tool, dict):
                  tool = {}
              relevant_project = {
                  key: project[key]
                  for key in (
                      "name",
                      "version",
                      "requires-python",
                      "dependencies",
                      "optional-dependencies",
                      "dynamic",
                  )
                  if key in project
              }
              return {
                  key: value
                  for key, value in {
                      "build-system": data.get("build-system"),
                      "project": relevant_project or None,
                      "dependency-groups": data.get("dependency-groups"),
                      "tool.uv": tool.get("uv"),
                  }.items()
                  if value is not None
              }

          before = subprocess.run(
              ["git", "show", "HEAD:pyproject.toml"],
              check=True,
              capture_output=True,
              text=True,
          ).stdout
          after = Path("pyproject.toml").read_text()
          lockfile = load_lockfile_relevant_pyproject(before) != load_lockfile_relevant_pyproject(after)
          with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as output:
              output.write(f"lockfile={str(lockfile).lower()}\n")
          PY
      - name: Refresh dependency lockfile
        if: steps.forge_changes.outputs.lockfile == 'true'
        run: uv lock
      - name: Create pull request
        uses: peter-evans/create-pull-request@5f6978faf089d4d20b00c7766989d076bb2fc7f1 # v8.1.1
        with:
          commit-message: "chore: sync Forge-managed infrastructure"
          branch: chore/forge-sync
          title: "chore: sync Forge-managed infrastructure"
          body: |
            This PR was automatically generated by the forge sync workflow.

            - Runs `forge sync --path . --yes`
            - Runs `uv lock` only when Forge changes lockfile-relevant `pyproject.toml` metadata
            - Syncs only Forge-managed infrastructure and required lockfile metadata
