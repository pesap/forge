minimum_prek_version: "0.4.1"

default_stages:
  - pre-commit

default_install_hook_types:
  - pre-commit
  - pre-push

repos:
  - repo: builtin
    hooks:
      - id: trailing-whitespace
        args:
          - --markdown-linebreak-ext=md
          - --markdown-linebreak-ext=markdown
      - id: end-of-file-fixer
      - id: check-case-conflict
      - id: check-toml
      - id: check-yaml
      - id: mixed-line-ending
        name: mixed line ending (LF-normalized files)
        args: ["--fix=lf"]
        exclude: '(?i)\.(bat|cmd)$'
      - id: mixed-line-ending
        name: mixed line ending (Windows command scripts)
        args: ["--fix=crlf"]
        files: '(?i)\.(bat|cmd)$'
      - id: check-merge-conflict
      - id: detect-private-key
      - id: check-added-large-files
        args: ["--maxkb=1000"]
{% if builtin_hooks is defined %}{{ builtin_hooks }}{% endif %}
  - repo: meta
    hooks:
      - id: check-hooks-apply
      - id: check-useless-excludes

  - repo: local
    hooks:
      - id: taplo-format
        name: taplo format
        entry: uvx --from taplo==0.9.3 taplo fmt
        language: system
        types_or: [toml]
      - id: taplo-lint
        name: taplo lint
        entry: uvx --from taplo==0.9.3 taplo check
        language: system
        types_or: [toml]
